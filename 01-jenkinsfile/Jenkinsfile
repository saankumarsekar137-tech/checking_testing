pipeline{
    agent any
    stages{
        stage('first stage'){
            steps{
                sh '''
                    hostname=$(hostname)
                    echo $hostname
                '''
            }
        
        }
        
        stage('second stage'){
            steps{
                sh '''
                    whoami
                    free -h
                '''    
            }
        }

        stage('python stage'){
            steps{
                sh '''
                    cd 01-jenkinsfile/
                    python3 test.py
                '''    
            }
        }

        stage('frontend build'){
            steps{
                sh '''
                    cd todo-app/frontend/
                    node --check app.js
                    node build.js
                    test -s dist/index.html
                    test -s dist/styles.css
                    test -s dist/app.js
                    echo "Frontend build completed."
                '''
            }
        }

        stage('backend build and test'){
            steps{
                sh '''
                    cd todo-app/backend/
                    node --check server.js
                    node build.js
                    node --check dist/server.js
                    node --test
                    echo "Backend build and tests completed."
                '''
            }
        }
    }
}