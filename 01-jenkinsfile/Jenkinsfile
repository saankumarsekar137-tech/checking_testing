pipeline{
    agent any
    stages{
        stage('first stage'){
            steps{
                sh '''
                    hostname=$(hostname)
                    echo $hostname
                '''
            }
        
        }
        
        stage('second stage'){
            steps{
                sh '''
                    whoami
                    free -h
                '''    
            }
        }

        stage('python stage'){
            steps{
                sh '''
                    python3 test.py
                '''    
            }
        }
    }
}