pipeline{
    agent any
    stages{
        stage('first stage'){
            steps{
                sh '''
                    hostname=$(hostname)
                    echo $hostname
                '''
            }
        
        }
        
        stage('second stage'){
            steps{
                sh '''
                    whoami
                    free -h
                '''    
            }
        }

        stage('python stage'){
            steps{
                sh '''
                    cd 01-jenkinsfile/
                    python3 test.py
                '''    
            }
        }

        stage('todo app stage'){
            steps{
                sh '''
                    cd todo-app/
                    test -s index.html
                    test -s styles.css
                    test -s app.js
                    node --check app.js
                    echo "Todo app files are present and JavaScript syntax is valid."
                '''
            }
        }
    }
}